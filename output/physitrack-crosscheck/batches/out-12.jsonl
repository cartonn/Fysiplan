{"nr": 574, "naam": "Seated calfs raises", "groep": "Seated Chair", "set": "bestaand", "physitrack_url": "https://au.physitrack.com/home-exercise-video/seated-heel-raise", "physitrack_titel": "Seated Heel/Toe Raise (JEMS)", "uitleg_oordeel": "ok", "tekening_oordeel": "ok", "avatar_oordeel": "licht afwijkend", "video": "nee", "video_oordeel": "", "nieuwe_uitleg": "", "opmerking": "Avatar toont de hielen plat op de vloer (beginhouding); de tekening toont de hielen omhoog. Avatar met geheven hielen maken."}
